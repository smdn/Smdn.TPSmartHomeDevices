<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Enables publishing via Native AOT compilation. -->
    <PublishAot>true</PublishAot>

    <!--
      Set to `false` to suppress warning IL3058, which is reported AOT compilation
      when dependent libraries do not explicitly declare AOT compatibility.
    -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Smdn.TPSmartHomeDevices.Tapo" Version="[2.2.0,3.0.0)" />
    <PackageReference Include="Smdn.TPSmartHomeDevices.MacAddressEndPoint" Version="[1.3.0,2.0.0)" />
    <PackageReference Include="Smdn.Net.AddressResolution" Version="[1.4.0,2.0.0)" />
  </ItemGroup>

</Project>
